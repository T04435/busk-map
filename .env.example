# Server-side only. Blank or SET_ME means "not configured": that provider falls back.

# Qloo hackathon API. Without it, Qloo data is labelled synthetic test data.
QLOO_API_KEY=
# Optional; defaults to https://hackathon.api.qloo.com
# QLOO_API_BASE_URL=
# Optional; send Qloo calls through the NotOnQ proxy first, e.g. https://notonq.vercel.app/q/app/busk-map
# (fills artists Qloo lacks, labelled). Qloo direct (QLOO_API_BASE_URL) is the fallback. Blank = off.
# QLOO_PROXY_BASE_URL=
# Optional; live Qloo requests Busk Map may send per UTC day (default 2000). At the limit new plans pause and the examples are offered.
# QLOO_DAILY_BUDGET=2000

# Vercel AI Gateway. On Vercel this comes from OIDC; locally run
#   vercel env pull .env.local --yes --scope cubanos-dev
# (refreshes VERCEL_OIDC_TOKEN), or set an API key.
AI_GATEWAY_API_KEY=

# Postgres (Neon, pooled): comparisons, stored runs and short plan links.
DATABASE_URL=
# Ticketmaster Discovery API
TICKETMASTER_API_KEY=
# Last.fm API
LASTFM_API_KEY=
# Spotify Web API (client credentials, catalogue only)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Test switches (ignored when VERCEL_ENV=production):
# BUSKMAP_OFFLINE=1        synthetic fixtures for every provider and a mock model (free, deterministic)
# BUSKMAP_ALLOW_FAULTS=1   allow ?faults=qloo,footfall,... to simulate outages
