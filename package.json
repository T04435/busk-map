{
  "name": "busk-map",
  "version": "1.1.1",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "vercel-build": "node scripts/migrate.mjs --if-production && pnpm build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "e2e:late": "BUSKMAP_FAKE_NOW=2026-10-16T21:30:00+11:00 playwright test late-clock.spec.ts",
    "check:fixtures": "node scripts/check-fixtures.mjs",
    "check:version-tag": "node scripts/check-version-tag.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm check:fixtures && pnpm build",
    "purge:spotify": "node scripts/purge-spotify.mjs",
    "db:migrate:dev": "node --env-file=.env.development.local scripts/migrate.mjs",
    "prepare": "simple-git-hooks || true",
    "commitlint": "commitlint",
    "release-notes": "git-cliff --unreleased --tag \"${NEXT_TAG:?set NEXT_TAG, e.g. NEXT_TAG=v1.0.2}\""
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.141",
    "@neondatabase/serverless": "^1.2.0",
    "ai": "^7.0.138",
    "botid": "1.5.11",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.56.0",
    "maplibre-gl": "^6.14.0",
    "next": "16.4.0",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "git-cliff": "2.14.2",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@11.0.9",
  "engines": {
    "node": "24.x"
  },
  "simple-git-hooks": {
    "commit-msg": "pnpm exec commitlint --edit \"$1\""
  }
}
